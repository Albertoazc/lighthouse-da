---
/**
 * Tarjeta editorial de una publicación. Variantes:
 *  - lead: destacada principal (imagen grande + texto a la derecha)
 *  - standard: imagen, categoría, título, resumen y firma (listados y recomendaciones)
 *  - compact: miniatura y título (columna lateral)
 *  - list: solo texto (listas por categoría)
 * Toda la tarjeta es clicable mediante el enlace del título (un único enlace por tarjeta).
 */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { fechaPublicacion, fechaISO, nombreCategoria, rutaPublicacion, tiempoLectura, type Publicacion } from '../lib/publicaciones';

interface Props {
  post: Publicacion;
  variant?: 'lead' | 'standard' | 'compact' | 'list';
  headingLevel?: 'h2' | 'h3' | 'h4';
  showDescription?: boolean;
  eager?: boolean;
}
const { post, variant = 'standard', headingLevel = 'h3', showDescription = variant !== 'compact' && variant !== 'list', eager = false } = Astro.props;
const { data } = post;
const autor = await getEntry(data.author);
const Heading = headingLevel;
const sizes = {
  lead: '(max-width: 740px) 100vw, 60vw',
  standard: '(max-width: 560px) 100vw, (max-width: 960px) 50vw, 33vw',
  compact: '96px',
  list: '0px',
}[variant];
const widths = variant === 'compact' ? [96, 192] : variant === 'lead' ? [640, 960, 1280, 1600] : [400, 640, 800];
---
<article class:list={['pub-card', `pub-card--${variant}`]}>
  {variant !== 'list' && (
    <div class="pub-card__media">
      <Image src={data.coverImage} alt="" widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
    </div>
  )}
  <div class="pub-card__body">
    {variant !== 'compact' && (
      <p class="pub-card__kicker">
        <span>{nombreCategoria(data.category)}</span>
        {data.demo && <span class="pub-card__flag">Demostración</span>}
      </p>
    )}
    <Heading class="pub-card__title"><a href={rutaPublicacion(post.id)}>{data.title}</a></Heading>
    {showDescription && <p class="pub-card__summary">{data.description}</p>}
    <p class="pub-card__meta">
      {variant !== 'compact' && autor && <span>{autor.data.name}</span>}
      <time datetime={fechaISO(data.publishedAt)}>{fechaPublicacion(data.publishedAt)}</time>
      {variant === 'lead' && <span>{tiempoLectura(post)} min de lectura</span>}
    </p>
  </div>
</article>
