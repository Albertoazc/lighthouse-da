---
interface Item { cifra: string; detalle: string; }
interface Props { items: Item[]; simulado?: boolean; }
const { items, simulado = true } = Astro.props;
---
<div class="report-metrics" aria-label={simulado ? 'Indicadores destacados del ejercicio simulado' : 'Indicadores destacados'}>
  {items.map((item, i) => (
    <div class="report-metric">
      <span class="metric-count">{String(i + 1).padStart(2, '0')} / {simulado ? 'DATO DE MUESTRA' : 'INDICADOR'}</span>
      <strong>{item.cifra}</strong>
      <span class="metric-detail">{item.detalle}</span>
    </div>
  ))}
</div>
<style>
  .report-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:30px 0 39px;}
  .report-metric{border:1px solid #dae8dd;border-radius:10px;background:linear-gradient(140deg,#f9fcf7,#eef6ee);padding:21px 18px 19px;display:flex;flex-direction:column;gap:5px;min-width:0;}
  .metric-count{letter-spacing:1.2px;font-size:9px;font-weight:800;color:#6c947a;}
  strong{font:400 clamp(31px,3vw,45px)/1.15 'DM Serif Display',Georgia,serif;color:#183f4c;margin-top:9px;}
  .metric-detail{font-size:11px;line-height:1.5;color:#587176;}
  @media(max-width:560px){.report-metrics{grid-template-columns:1fr;}.report-metric{padding:15px 17px;}.report-metric strong{font-size:34px}}
</style>
