---
interface Dato { nombre:string; valor:number; color:string; }
interface Props { titulo:string; subtitulo:string; data:Dato[]; fuente?:string; unidad?:string; }
const {titulo, subtitulo,data,fuente='Fuente: cálculo sobre índices simulados, 2019–2025.',unidad='%'} = Astro.props;
if (!data.length || data.some(d=>!Number.isFinite(d.valor))) throw new Error('InformeBarras necesita valores numéricos finitos.');
const minScale=Math.min(0,Math.floor(Math.min(...data.map(d=>d.valor))/10)*10);
const maxScale=Math.max(0,Math.ceil(Math.max(...data.map(d=>d.valor))/10)*10);
const span=Math.max(10,maxScale-minScale);
const position=(value:number)=>(value-minScale)/span*100;
const ticks=Array.from({length:4},(_,i)=>minScale+span*i/3);
const format=(value:number)=>value.toLocaleString('es-DO',{maximumFractionDigits:1});
---
<figure class="report-bars">
  <header>
    <span class="figure-marker">VISUALIZACIÓN / 02</span>
    <h3>{titulo}</h3>
    <p>{subtitulo}</p>
  </header>
  <div class="bars" role="img" aria-label={`${titulo}: ${data.map(d=>`${d.nombre}, ${format(d.valor)} ${unidad}`).join('; ')}`}>
    {data.map(d => <div class="bar-row">
      <div class="bar-label">{d.nombre}</div>
      <div class="bar-track"><div class="bar-fill" style={`left:${position(Math.min(0,d.valor))}%;width:${Math.abs(d.valor)/span*100}%;background:${d.color}`}></div><span class="bar-zero" style={`left:${position(0)}%`}></span></div>
      <strong class="bar-value">{d.valor>0?'+':''}{format(d.valor)} {unidad}</strong>
    </div>)}
  </div>
  <div class="bar-axis" aria-hidden="true">{ticks.map(t=><span>{format(t)} {unidad}</span>)}</div>
  <figcaption>{fuente} La comparación no implica una relación causal entre las variables.</figcaption>
</figure>
<style>
  .report-bars{margin:34px 0 40px;padding:27px 28px 20px;border:1px solid #dce9df;border-radius:12px;background:#fff;box-shadow:0 12px 34px #153b450a;}
  .figure-marker{font-size:10px;letter-spacing:1.7px;font-weight:800;color:#6c9b70;}
  h3{font:400 clamp(22px,2.8vw,29px)/1.2 'DM Serif Display',Georgia,serif;color:#153d4c;margin:9px 0 5px;}
  header p{color:#72878b;font-size:13px;line-height:1.5;margin:0;}
  .bars{display:grid;gap:22px;margin-top:34px;}
  .bar-row{display:grid;grid-template-columns:160px 1fr 70px;gap:18px;align-items:center;}
  .bar-label{font-size:12px;color:#3d5e68;font-weight:700;line-height:1.3;}
  .bar-track{position:relative;height:30px;border-radius:3px;background:repeating-linear-gradient(to right,#edf3ee 0,#edf3ee calc(33.333% - 1px),#dde8de calc(33.333% - 1px),#dde8de 33.333%);overflow:hidden;}
  .bar-fill{position:absolute;height:100%;border-radius:3px;}
  .bar-zero{position:absolute;height:100%;border-left:1px solid #78908c;}
  .bar-value{font-size:14px;font-weight:800;color:#214f5b;text-align:right;white-space:nowrap;}
  .bar-axis{display:flex;justify-content:space-between;margin:15px 82px 26px 178px;font-size:10px;color:#78908c;}
  figcaption{border-top:1px solid #e6eee8;padding-top:15px;color:#7a8e8f;line-height:1.6;font-size:11px;}
  @media(max-width:650px){.report-bars{padding:18px 14px;}.bar-row{grid-template-columns:1fr 70px;gap:8px;}.bar-label{grid-column:1/-1;}.bar-axis{margin:16px 80px 23px 0;}}
</style>
