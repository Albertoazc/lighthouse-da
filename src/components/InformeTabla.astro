---
interface Registro { periodo:string; publica:number; privada:number; actividad:number; }
interface Props { registros:Registro[]; titulo?:string; unidad?:string; fuente?:string; }
const {registros,titulo='Serie completa del ejercicio ilustrativo',unidad='Índices sintéticos · Año base 2019 = 100',fuente='Todos los valores son ficticios. Fuente: elaboración demostrativa de Lighthouse D&A.'} = Astro.props;
---
<figure class="report-table-figure">
  <figcaption><span>TABLA / 01</span><strong>{titulo}</strong><small>{unidad}</small></figcaption>
  <div class="scroll-table" tabindex="0" role="region" aria-label={titulo}>
    <table>
      <caption class="visually-hidden">{titulo}. {unidad}</caption>
      <thead><tr><th scope="col">Año</th><th scope="col">Inversión pública</th><th scope="col">Inversión privada</th><th scope="col">Actividad económica</th></tr></thead>
      <tbody>{registros.map((r,i)=><tr class:list={{last:i===registros.length-1}}><th scope="row">{r.periodo}</th><td>{r.publica}</td><td>{r.privada}</td><td>{r.actividad}</td></tr>)}</tbody>
    </table>
  </div>
  <p>{fuente}</p>
</figure>
<style>
  .report-table-figure{margin:32px 0 42px;padding:25px 27px 20px;border:1px solid #dce9df;border-radius:12px;background:#fff;box-shadow:0 12px 34px #153b450a;}
  figcaption{display:flex;flex-direction:column;gap:4px;margin-bottom:18px;}
  figcaption span{font-size:10px;letter-spacing:1.7px;font-weight:800;color:#6c9b70;}
  figcaption strong{font:400 25px/1.3 'DM Serif Display',Georgia,serif;color:#153d4c;margin-top:4px;}
  figcaption small{font-size:12px;color:#73878b;}
  .scroll-table{width:100%;overflow-x:auto;}
  table{width:100%;min-width:530px;border-collapse:collapse;font-variant-numeric:tabular-nums;font-size:13px;}
  th,td{padding:14px 11px;border-bottom:1px solid #e4ece6;text-align:right;color:#425d66;}
  th:first-child{text-align:left;}
  thead th{background:#edf5ed;color:#2e5a60;font-size:11px;font-weight:800;}
  tbody tr:nth-child(even){background:#fafcf9;}
  tbody .last{background:#e8f2e7;font-weight:800;}
  tbody .last th,tbody .last td{color:#1b5057;}
  figure p{font-size:11px;line-height:1.6;color:#7c9090;margin:15px 0 0;}
  @media(max-width:560px){.report-table-figure{padding:19px 13px;}}
</style>
