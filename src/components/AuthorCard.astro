---
/** Tarjeta de autor: se alimenta de src/content/autores/, nunca de datos escritos en el informe. */
import { Image } from 'astro:assets';
import type { Autor } from '../lib/publicaciones';
import { rutaAutor } from '../lib/publicaciones';

interface Props { autor: Autor; label?: string; extended?: boolean; headingLevel?: 'h2' | 'h3'; }
const { autor, label = 'Sobre el autor', extended = false, headingLevel = 'h2' } = Astro.props;
const { data } = autor;
const Heading = headingLevel;
const parrafos = extended && data.longBio ? data.longBio.split(/\n\s*\n/).map(p => p.replace(/\s+/g, ' ').trim()) : [data.bio];
---
<section class="author-card" aria-label={label}>
  <Image class="author-card__photo" src={data.photo} alt={data.photoAlt ?? `Fotografía de ${data.name}`} width={240} />
  <div class="author-card__body">
    <p class="author-card__label">{label}</p>
    <Heading class="author-card__name">{extended ? data.name : <a href={rutaAutor(autor.id)}>{data.name}</a>}</Heading>
    <p class="author-card__role">{data.role}</p>
    {parrafos.map(p => <p class="author-card__bio">{p}</p>)}
    {(data.links.length > 0 || !extended) && (
      <ul class="author-card__links">
        {!extended && <li><a href={rutaAutor(autor.id)}>Ver perfil y publicaciones <span aria-hidden="true">→</span></a></li>}
        {data.links.map(link => <li><a href={link.url} rel="me noopener" target="_blank">{link.label}<span class="visually-hidden"> (abre en una pestaña nueva)</span> <span aria-hidden="true">↗</span></a></li>)}
      </ul>
    )}
  </div>
</section>

<style>
.author-card { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: var(--space-5); padding: var(--space-5) 0; border-top: 2px solid var(--color-ink); }
.author-card :global(.author-card__photo) { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; background: var(--color-surface); border: var(--border); }
.author-card__label { margin: 0 0 6px; font: 700 10px/1.3 var(--font-sans); letter-spacing: .16em; text-transform: uppercase; color: var(--color-accent-strong); }
.author-card .author-card__name { margin: 0; font: 400 clamp(1.4rem, 1.2rem + .8vw, 1.75rem)/1.2 var(--font-display); color: var(--color-ink); }
.author-card__name a:hover { text-decoration: underline; text-underline-offset: .15em; }
.author-card__role { margin: 4px 0 var(--space-3); font: 600 var(--text-sm)/1.4 var(--font-sans); color: var(--color-muted); }
.author-card__bio { margin: 0 0 var(--space-3); font: 400 var(--text-base)/1.65 var(--font-reading); color: var(--color-text); }
.author-card__links { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font: 700 var(--text-sm)/1.4 var(--font-sans); }
.author-card__links a { color: var(--color-link); border-bottom: 1px solid var(--color-accent); padding-bottom: 2px; }
.author-card__links a:hover { color: var(--color-accent-strong); }

  @media (max-width: 560px) {
    .author-card { grid-template-columns: 64px minmax(0, 1fr); gap: var(--space-4); }
    .author-card :global(.author-card__photo) { width: 64px; height: 64px; }
  }
</style>
