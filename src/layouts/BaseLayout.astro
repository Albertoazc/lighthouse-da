---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitio } from '../config/sitio';
import '../styles/tokens.css';
import '../styles/global.css';

interface ArticleMeta {
  publishedTime: Date;
  modifiedTime?: Date;
  author: string;
  section: string;
  tags: string[];
}
interface Props {
  title?: string;
  description?: string;
  active?: string;
  pageClass?: string;
  /** Marca la página como `noindex` (demostraciones, borradores, listados de solo demostraciones). */
  demo?: boolean;
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  article?: ArticleMeta;
  jsonLd?: Record<string, unknown>;
}
const {
  title = sitio.nombre,
  description = sitio.descripcion,
  active = 'inicio',
  pageClass = '',
  demo = false,
  image = sitio.imagenSocial,
  imageAlt = sitio.nombre,
  type = 'website',
  article,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const socialSrc = typeof image === 'string' ? image : (await getImage({ src: image, width: 1200, format: 'jpg' })).src;
const socialImage = new URL(socialSrc, Astro.site ?? Astro.url).href;
const rss = new URL('/rss.xml', Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang={sitio.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f9f6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {demo && <meta name="robots" content="noindex,follow" />}
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:locale" content={sitio.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {article && <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
      <meta property="article:author" content={article.author} />
      <meta property="article:section" content={article.section} />
      {article.tags.map(tag => <meta property="article:tag" content={tag} />)}
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="alternate" type="application/rss+xml" title={`${sitio.nombre} — Publicaciones`} href={rss} />
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..800&family=DM+Serif+Display&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap" rel="stylesheet" />
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    {pageClass === 'article-page' && <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>}
    <Header active={active} article={pageClass === 'article-page'} />
    <slot />
    <Footer />
    <script>
      import '../scripts/site.js';
      import '../scripts/search.js';
    </script>
  </body>
</html>
